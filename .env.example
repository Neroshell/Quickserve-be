# ==============================================================================
# QUICKSERVE BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# MANDATORY PRODUCTION DEPENDENCIES (Required in NODE_ENV=production)
# ------------------------------------------------------------------------------

# The MongoDB connection string (must support transactions, e.g., Replica Set or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/quickserve

# The Redis URL for session storage, presence, and caching
REDIS_URL=redis://default:replace-with-redis-password@redis.example.invalid:6379

# A secure secret used to sign session cookies (must be at least 32 chars)
SESSION_SECRET=replace_with_a_long_random_secret_string

# Stripe Secret Key for payments and billing
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret for validating incoming webhook signatures
STRIPE_WEBHOOK_SECRET=whsec_...

# The base URL of the frontend application (used for CORS and email links)
FRONTEND_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# OPTIONAL / FEATURE-GATED / DEFAULTS
# ------------------------------------------------------------------------------

# Environment (Defaults to "development")
NODE_ENV=development

# API Port (Defaults to 5000)
PORT=5000

# Backoffice / Platform Admin base URL (Optional, added to CORS if present)
BACKOFFICE_BASE_URL=http://localhost:3001

# Secret for internal cron/recovery endpoints (Bearer token)
CRON_SECRET=replace_with_internal_secret

# Fail-open deadline for response-cache GET/SET/DEL commands (Defaults to 500ms)
CACHE_COMMAND_TIMEOUT_MS=500

# Resend API Key for transactional emails (Optional, defaults to console logging)
RESEND_API_KEY=re_...

# Email "from" addresses (Optional, defaults are used if omitted)
EMAIL_FROM_RECEIPTS="QuickServe <receipts@yourdomain.com>"
EMAIL_FROM_AUTH="QuickServe Auth <auth@yourdomain.com>"
EMAIL_FROM_ONBOARDING="QuickServe <onboarding@yourdomain.com>"
EMAIL_FROM_BILLING="QuickServe Billing <billing@yourdomain.com>"

# Cloudinary configuration (Optional, for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# HMAC key for opaque restaurant-arrival links. Use at least 32 random chars.
# SESSION_SECRET is accepted as a compatibility fallback.
RESERVATION_ARRIVAL_TOKEN_SECRET=replace_with_32_random_chars

# HMAC key for QR capability signing
QR_CAPABILITY_SIGNING_SECRET=replace_with_random_signing_secret

# Optional local-development override for restaurant arrival reminders.
RESTAURANT_ARRIVAL_REMINDER_TEST_DELAY_SECONDS=60

# Server-only key for Places API; restrict it to the API and backend hosts/IPs.
GOOGLE_PLACES_API_KEY=replace_with_google_api_key

# Cooldown (in minutes) before a customer can create a new waiter request.
WAITER_REQUEST_COOLDOWN_MINUTES=5

# Stripe Billing Webhook Secret (separate from order/payment webhook)
STRIPE_BILLING_WEBHOOK_SECRET=whsec_...

# Platform admin emails (comma-separated, for Supabase backoffice auth)
PLATFORM_ADMIN_EMAILS=admin@example.com

# Supabase (Optional, for platform admin backoffice)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI Analyst (Optional, for Cloudflare Workers AI)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_AI_TOKEN=your_ai_token
CLOUDFLARE_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_AI_TIMEOUT_MS=60000
CLOUDFLARE_AI_MAX_TOKENS=2048
CLOUDFLARE_AI_TEMPERATURE=0.3

# ------------------------------------------------------------------------------
# BULLMQ CONFIGURATION (Feature Flags)
# ------------------------------------------------------------------------------
# BullMQ creates dedicated ioredis connections for API producers and workers.
# Existing session and SSE Redis clients remain separate.
# Any enabled scheduler/worker flag REQUIRES a separately running worker process:
#   npm run worker  (or  node src/workers/index.js)
# The worker process registers recurring Job Schedulers and processes jobs.
# The API process only enqueues jobs; it never processes them.

# Master switch for BullMQ (required for any queue feature)
BULLMQ_ENABLED=true

# Diagnostics (Enable only while running an intentional deployment smoke test)
BULLMQ_DIAGNOSTIC_ENABLED=false

# Transactional emails (Phase 1) — requires worker
BULLMQ_EMAILS_ENABLED=false

# Reservation delayed state schedulers (Phase 2) — requires worker
BULLMQ_RESERVATION_SCHEDULERS_ENABLED=false

# Billing subscription lifecycle (Phase 2) — requires worker
BULLMQ_BILLING_SCHEDULERS_ENABLED=false

# Post-payment CRM projections (Phase 3) — requires worker
BULLMQ_POST_PAYMENT_ENABLED=false

# Inventory reconciliation (Phase 4) — requires worker
BULLMQ_INVENTORY_SCHEDULERS_ENABLED=false

# Notification delivery (Phase 5) — requires worker
BULLMQ_NOTIFICATIONS_ENABLED=false

# AI Analyst weekly reports — requires worker
AI_ANALYST_WEEKLY_ENABLED=false
