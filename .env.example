# BullMQ is opt-in during Phase 0. Keep disabled until the API and worker use
# the same Redis provider in the target environment.
BULLMQ_ENABLED=true
BULLMQ_DIAGNOSTIC_ENABLED=false
BULLMQ_EMAILS_ENABLED=false
BULLMQ_RESERVATION_SCHEDULERS_ENABLED=false
BULLMQ_BILLING_SCHEDULERS_ENABLED=false
BULLMQ_POST_PAYMENT_ENABLED=false
REDIS_URL=rediss://default:replace-with-redis-password@redis.example.invalid:6379

# HMAC key for opaque restaurant-arrival links. Use at least 32 random
# characters and configure the same value in the API and worker deployments.
# SESSION_SECRET is accepted as a compatibility fallback.
RESERVATION_ARRIVAL_TOKEN_SECRET=testtoken123

# Optional local-development override for restaurant arrival reminders. A
# positive integer schedules the real BullMQ email job this many seconds from
# now. It is always ignored when NODE_ENV=production.
RESTAURANT_ARRIVAL_REMINDER_TEST_DELAY_SECONDS=60

# BullMQ creates dedicated ioredis connections for API producers and workers.
# Existing session and SSE Redis clients remain separate.
# Diagnostics are disabled by default. Enable BULLMQ_DIAGNOSTIC_ENABLED only
# while running an intentional deployment smoke test.
# BULLMQ_EMAILS_ENABLED controls only the approved Phase 1 transactional emails;
# keep it false to use the existing direct-delivery rollback path.
# Phase 2 scheduler flags are independent and default off. Only the dedicated
# worker process registers recurring Job Schedulers; API processes only enqueue
# versioned delayed reservation jobs when the reservation flag is enabled.
# Never commit real Redis URLs or other secrets.
# Phase 3 moves only CRM projections after durable paid Order state. Its worker
# owns the repair scheduler; API processes enqueue individual order IDs only.
