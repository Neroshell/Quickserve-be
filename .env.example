# BullMQ is opt-in during Phase 0. Keep disabled until the API and worker use
# the same Redis provider in the target environment.
BULLMQ_ENABLED=false
BULLMQ_EMAILS_ENABLED=false
BULLMQ_RESERVATION_SCHEDULERS_ENABLED=false
BULLMQ_BILLING_SCHEDULERS_ENABLED=false
BULLMQ_POST_PAYMENT_ENABLED=false
REDIS_URL=

# BullMQ creates dedicated ioredis connections for API producers, workers, and
# QueueEvents. Existing session and SSE Redis clients remain separate.
# BULLMQ_EMAILS_ENABLED controls only the approved Phase 1 transactional emails;
# keep it false to use the existing direct-delivery rollback path.
# Phase 2 scheduler flags are independent and default off. Only the dedicated
# worker process registers recurring Job Schedulers; API processes only enqueue
# versioned delayed reservation jobs when the reservation flag is enabled.
# Never commit real Redis URLs or other secrets.
# Phase 3 moves only CRM projections after durable paid Order state. Its worker
# owns the repair scheduler; API processes enqueue individual order IDs only.
